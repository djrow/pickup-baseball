# ==============================================================================
# Community Starter Kit — Environment Configuration Example
# Copy to `.env` (Node.js) or `.dev.vars` (Cloudflare Pages) and customize.
# Never commit `.env` or `.dev.vars`.
# ==============================================================================

# ------------------------------------------------------------------------------
# Boot / Deploy Layer (resolved with zero D1 reads by src/app/config.js)
# ------------------------------------------------------------------------------

# Preset: "generic-community" (default for fresh forks) or "pickup-baseball"
COMMUNITY_PRESET=generic-community

# Public display name for your community
COMMUNITY_NAME="Community Hub"

# Canonical custom origin (optional). Leave empty to serve directly on *.pages.dev
PUBLIC_ORIGIN=

# Preview domain lockout: set to 1 alongside PUBLIC_ORIGIN to redirect/block *.pages.dev
LOCK_PREVIEW_ORIGIN=0

# Optional handbook or community rules link
HANDBOOK_URL=

# Email identity (server-only; never exposed on /api/config/public)
# Anyone logging in with ADMIN_EMAIL automatically receives Admin privileges
ADMIN_EMAIL=admin@example.org
ADMIN_NAME="Community Admin"
FROM_EMAIL="Community Hub <onboarding@resend.dev>"
REPLY_TO_EMAIL=

# Adapter selectors
# MAIL_PROVIDER: "mock" (local/dev default), "resend", or "brevo"
MAIL_PROVIDER=mock
# STORAGE_PROVIDER: "local" (default), "gdrive", or "r2"
STORAGE_PROVIDER=local

# Feature flags (0/1 or false/true; unset inherits from COMMUNITY_PRESET)
FEATURE_BATTING_PRACTICE=0
FEATURE_CERTIFIED_SHIFTS=0
FEATURE_SUNDAY_PRIORITY=0

# ------------------------------------------------------------------------------
# Node.js Local Runtime & Provider Secrets
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
DATA_DIR=./data

# Mail API keys (leave empty to use mock/console delivery in development)
RESEND_API_KEY=
BREVO_API_KEY=
