# Application Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Sunday Pickup Baseball"

# Administrator Account
# Anyone logging in with this email automatically has admin privileges to schedule games
ADMIN_EMAIL=admin@baseballcharity.org
ADMIN_NAME="League Organizer"

# SQLite Data Storage Directory
DATA_DIR=./data

# Resend Email Configuration (100% Free Tier - 3,000 emails/month)
# 1. Sign up at https://resend.com (Free)
# 2. Grab an API Key from your Resend dashboard (starts with re_...)
# 3. For testing, set FROM_EMAIL="Sunday Pickup Baseball <onboarding@resend.dev>"
#    For production with your domain, set FROM_EMAIL="Sunday Pickup Baseball <pickup@your-domain.org>"
RESEND_API_KEY=
FROM_EMAIL="Sunday Pickup Baseball <onboarding@resend.dev>"

# Alternative: Standard SMTP (Optional fallback if not using Resend API)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
