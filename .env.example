# Application Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Sunday Pickup Baseball"

# Administrator Account
# Anyone logging in with this email automatically has admin privileges to schedule games
ADMIN_EMAIL=admin@baseballcharity.org
ADMIN_NAME="League Organizer"

# SQLite Data Storage Directory
DATA_DIR=./data

# Email Service Configuration (Optional)
# If left blank, the app runs in Local Dev mode where all emails with clickable links
# are printed directly to the server console.
# Works with any standard SMTP provider: Brevo (free 300/day), Resend (free 3,000/mo),
# Zoho Mail, Amazon SES, or Gmail App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Sunday Pickup Baseball" <pickup@baseballcharity.org>
