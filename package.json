{
  "name": "lucid-maxwell",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "pages:dev": "npx wrangler pages dev public",
    "deploy": "npx wrangler pages deploy public --project-name pickup-baseball --branch trunk --commit-dirty=true",
    "deploy:cron": "npx wrangler deploy --config workers/cron-reminders/wrangler.toml",
    "d1:backup": "npx wrangler d1 export pickup-baseball-db --remote --output ./d1_backup.sql",
    "d1:backup:chat": "npx wrangler d1 export pickup-chat-db --remote --output ./d1_chat_backup.sql",
    "db:migrate": "node scripts/migrate-db.js",
    "seed": "node src/seed.js",
    "setup": "node scripts/setup.js",
    "setup:gdrive": "node scripts/setup-gdrive-secrets.js",
    "bump": "node scripts/bump-version.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:workerd && npm run test:browser && npm run security:scan",
    "check:quiet": "npm run lint && npm run typecheck && npm run test:quiet && npm run test:workerd:quiet && npm run test:browser:quiet && npm run security:scan:quiet",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "test": "node scripts/verify-all.js",
    "test:quiet": "node --test --test-reporter=dot scripts/verify-all.js",
    "test:workerd": "node --test tests/workerd/*.test.js",
    "test:workerd:quiet": "node --test --test-reporter=dot tests/workerd/*.test.js",
    "test:browser": "node scripts/browser-smoke.js",
    "test:browser:quiet": "node scripts/browser-smoke.js --quiet",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "security:scan": "node scripts/security-scan.js",
    "security:scan:quiet": "node scripts/security-scan.js --skip-audit --quiet",
    "security:scan:live": "node scripts/security-scan.js --live",
    "map:gen": "node scripts/gen-agent-map.js",
    "map:check": "node scripts/gen-agent-map.js --check",
    "i18n:sync": "node scripts/i18n-sync.js",
    "asset:register": "node scripts/register-asset.js",
    "test:impact": "node scripts/test-impact.js",
    "tokens:profile": "node scripts/token-profile.js",
    "tokens:scorecard": "node scripts/token-profile.js --cohort"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "miniflare": "^5.20261113.0-beta",
    "typescript": "^7.0.2",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true,
    "workerd@1.20261117.1": true
  }
}
