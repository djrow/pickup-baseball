{
  "name": "lucid-maxwell",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "pages:dev": "npx wrangler pages dev public",
    "deploy": "npx wrangler pages deploy public --project-name pickup-baseball --branch trunk --commit-dirty=true",
    "d1:backup": "npx wrangler d1 export pickup-baseball-db --remote --output ./d1_backup.sql",
    "d1:backup:chat": "npx wrangler d1 export pickup-chat-db --remote --output ./d1_chat_backup.sql",
    "seed": "node src/seed.js",
    "setup:gdrive": "node scripts/setup-gdrive-secrets.js",
    "bump": "node scripts/bump-version.js",
    "test": "node scripts/verify-all.js"
  },
  "keywords": [],
  "author": "",
