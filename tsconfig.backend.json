{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/app/**/*.js",
    "functions/**/*.js",
    "types/backend.d.ts"
  ]
}
